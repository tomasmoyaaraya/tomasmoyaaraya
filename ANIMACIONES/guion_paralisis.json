{
  "titulo": "Parálisis del sueño",
  "salida": "paralisis_del_sueno",
  "formato": "vertical",
  "voz": {
    "edge": "es-MX-JorgeNeural", "velocidad": "-5%", "tono": "-4Hz",
    "piper": "es-carlfm-x-low", "piper_lentitud": 1.22
  },
  "lineas": [
    {"texto": "Si alguna vez despiertas a las tres y treinta y tres, y no puedes moverte...",
     "dibujo": "ojos", "zoom": [1.0, 1.1], "pantalla": "NO ABRAS\nLOS OJOS",
     "glitch": [[0, 0.2], [2.4, 0.15]], "sfx": [["braam", 0]], "musica": "tension"},
    {"texto": "no abras los ojos.", "dibujo": "oscuridad", "zoom": [1.6, 1.2],
     "sfx": [["susurro", 0, 0.9, {"d": 2.2, "pan": 0.7}]], "musica": "baja", "pausa": 0.35},
    {"texto": "Yo los abrí.", "dibujo": "dormitorio", "despertar": true, "zoom": [1.15, 1.1],
     "foco": [0.62, 0.62], "min": 1.6},
    {"texto": "Tenía diecinueve años. Mi cuerpo no respondía.", "dibujo": "dormitorio",
     "zoom": [1.05, 1.2], "foco": [0.76, 0.66],
     "sfx": [["latido", 0, 0.7, {"d": 9, "bpm0": 60, "bpm1": 80}]]},
    {"texto": "Ni un dedo. Ni un músculo. Solo podía mover los ojos.", "dibujo": "dormitorio",
     "zoom": [1.35, 1.35], "foco": [0.72, 0.22], "fy": [0.45, 0.5]},
    {"texto": "El reloj marcaba las tres y treinta y tres.", "dibujo": "reloj_cambia",
     "zoom": [1.0, 1.15], "sfx": [["tictac", 0, 1.0, {"d": 4}]]},
    {"texto": "Y la puerta del cuarto, que siempre dejo cerrada...", "dibujo": "puerta_abre",
     "zoom": [1.0, 1.1], "sfx": [["crujido", 0.5, 1.0, {"d": 2.6}]], "musica": "baja"},
    {"texto": "estaba abierta.", "dibujo": "puerta", "golpe_zoom": true, "zoom": [1.12, 1.2],
     "foco": [0.45, 0.45], "pausa": 0.3},
    {"texto": "En el pasillo había alguien. Alto. Demasiado delgado. Sin rostro.",
     "dibujo": "figura_aparece", "zoom": [1.0, 1.25], "foco": [0.44, 0.41], "fy": [0.5, 0.45],
     "sfx": [["susurro", 1.0, 1.0, {"d": 3.5, "pan": -0.6}]], "musica": "tension"},
    {"texto": "Cada vez que parpadeaba... estaba más cerca.", "dibujo": "figura_acerca",
     "parpadeos": [0.33, 0.66], "zoom": [1.05, 1.12], "min": 3.6,
     "sfx": [["pasos", "p0.30", 1.0, {"n": 1}], ["pasos", "p0.63", 1.0, {"n": 1}]]},
    {"texto": "Sentí el colchón hundirse a mis pies.", "dibujo": "figura_cama", "zoom": [1.3, 1.45],
     "fy": [0.36, 0.3], "temblor": 1,
     "sfx": [["latido", 0, 1.0, {"d": 11, "bpm0": 95, "bpm1": 150}]]},
    {"texto": "Algo se sentó sobre mi pecho. No podía respirar. Quise gritar...",
     "dibujo": "presion_baja", "zoom": [1.0, 1.15], "temblor": 2, "musica": "tension",
     "sfx": [["respiracion", 0, 0.9, {"d": 5}]]},
    {"texto": "y no salió nada.", "dibujo": "presion", "zoom": [1.2, 1.3], "temblor": 3,
     "musica": "silencio", "pausa": 0.6},
    {"texto": "Entonces, a centímetros de mi cara...", "dibujo": "ojos_cerrados", "zoom": [1.0, 1.2],
     "musica": "silencio", "sfx": [["subida", "fin", 0.9, {"d": 2.8}]], "pausa": 0.3},
    {"texto": "abrió los ojos.", "dibujo": "ojos_abren", "susto": 0.3, "zoom": [1.0, 1.08],
     "musica": "silencio", "pausa": 1.3},
    {"texto": "Desperté con la luz del sol. La puerta estaba cerrada. Solo fue un sueño, me dije.",
     "dibujo": "amanecer", "despertar": true, "zoom": [1.0, 1.12], "foco": [0.5, 0.6],
     "musica": "calma"},
    {"texto": "Hasta que vi las sábanas.", "dibujo": "sabanas_aparecen", "zoom": [1.0, 1.1],
     "foco": [0.48, 0.48], "musica": "tension", "sfx": [["braam", 0.2, 0.7]], "min": 2.4},
    {"texto": "Marcas de dedos. Demasiado largos.", "dibujo": "sabanas", "zoom": [1.2, 1.45],
     "foco": [0.48, 0.48], "fy": [0.45, 0.42], "pausa": 0.4},
    {"texto": "Y anoche... volví a despertar a las tres y treinta y tres.", "dibujo": "reloj",
     "despertar": true, "zoom": [1.0, 1.3], "pantalla": "¿A TI TE\nHA PASADO?", "musica": "tension",
     "sfx": [["tictac", 0, 1.0, {"d": 6}]], "pausa": 0.5}
  ]
}
